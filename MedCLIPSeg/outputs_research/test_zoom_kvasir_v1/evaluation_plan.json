      "g5_all_seeds_positive_on_macro_ood": true,
      "pass_rule": "g1 and g2 and g3 and g4 and g5",
      "if_fail": "the two-pass direction is dropped; no retuning on these data"
    },
    "if_final_model_is_the_combination_arm": "the same locked configuration is applied without re-selection",
    "secondary_reported_not_gating": [
      "image-level permutation and Wilcoxon tests, bootstrap interval, per-seed consistency",
      "small-target and lesion-size strata, failure counts, share of images given a second pass",
      "unique-image sensitivity for ColonDB and CVC300"
    ],
    "disclosures": [
      "The size-prior weakness that motivated the method was quantified on Test/OOD predictions of these same checkpoints.",
      "The configuration was selected on synthetically rescaled source Val images; that proxy overstates the effect (see pilot acceptance).",
      "The five test sets were used before with earlier models; they are not untouched holdouts.",
      "ColonDB and CVC300 share 52 exact image hashes and are not independent cohorts.",
      "The second pass adds one MC30 inference for every zoomed image."
    ],
    "statistics": {
      "permutation_draws": 100000,
      "bootstrap_draws": 10000,
      "rng_seed": 20261005
    }
