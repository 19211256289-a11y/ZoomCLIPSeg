MedCLIPSeg/outputs_research/**/*.png
MedCLIPSeg/outputs_research/**/*.tif

# Generated by paper/scripts
paper/figures/*
paper/tables/*
!paper/figures/.gitkeep
!paper/tables/.gitkeep
